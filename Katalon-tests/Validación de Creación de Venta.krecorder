<tr><td>open</td><td>http://localhost:5173/ventas<datalist><option>http://localhost:5173/ventas</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//div[@id='app']/div/div/div[2]/button<datalist><option>xpath=//div[@id='app']/div/div/div[2]/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Gestión de Ventas'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Logout'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Ver Detalles'])[1]/preceding::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Actualizar Lista'])[1]/preceding::button[2]</option><option>xpath=//*/text()[normalize-space(.)='Agregar Venta']/parent::*</option><option>xpath=//div/div[2]/button</option><option>css=button.action-button.add-button</option></datalist></td><td></td></tr>
<tr><td>click</td><td>id=empresa_cliente<datalist><option>id=empresa_cliente</option><option>xpath=//input[@id='empresa_cliente']</option><option>xpath=//div[@id='app']/div/div[2]/div/form/div/div/input</option><option>xpath=//form/div/div/input</option><option>css=#empresa_cliente</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id=empresa_cliente<datalist><option>id=empresa_cliente</option><option>xpath=//input[@id='empresa_cliente']</option><option>xpath=//div[@id='app']/div/div[2]/div/form/div/div/input</option><option>xpath=//form/div/div/input</option><option>css=#empresa_cliente</option></datalist></td><td>Zapatos Pérez</td></tr>
<tr><td>click</td><td>xpath=//div[@id='app']/div/div[2]/div<datalist><option>xpath=//div[@id='app']/div/div[2]/div</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Pagada'])[5]/following::div[2]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='$300.00'])[2]/following::div[2]</option><option>xpath=//div/div[2]/div</option><option>css=div.modal-content</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//button[@type='button']<datalist><option>xpath=//button[@type='button']</option><option>xpath=//div[@id='app']/div/div[2]/div/form/div/div/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Empresa del Cliente:'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Agregar Nueva Venta'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='NIT:'])[1]/preceding::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Dirección de Facturación:'])[1]/preceding::button[1]</option><option>xpath=//*/text()[normalize-space(.)='Buscar']/parent::*</option><option>xpath=//form/div/div/button</option><option>css=button.search-button</option></datalist></td><td></td></tr>
