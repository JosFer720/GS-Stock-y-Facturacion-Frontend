# ─────────────────────────────────────────────────────────────
# Variables para docker-compose (copiar a `.env` en esta carpeta)
#   cp .env.example .env  y rellenar los valores reales.
# El archivo `.env` está ignorado por git: NUNCA lo subas.
# ─────────────────────────────────────────────────────────────

# --- Base de datos PostgreSQL ---
DB_USER=admin
DB_NAME=mydb
# Contraseña de la base de datos (obligatoria, sin valor por defecto)
DB_PASSWORD=

# --- Autenticación ---
# Secreto para firmar los JWT. Generar uno aleatorio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# --- Frontend ---
FRONTEND_URL=https://importadoragenser.com

# --- Correo (nodemailer) ---
EMAIL_USER=
# App password de Gmail (obligatoria)
EMAIL_PASSWORD=
EMAIL_FROM=GS Stock <distribuidoragenser@gmail.com>

# --- Puertos / despliegue (opcionales) ---
# FRONTEND_PORT=3002
# POSTGRES_PORT=5434
# RESTART_POLICY=unless-stopped
# DOCKERFILE_FRONTEND=Dockerfile.prod
