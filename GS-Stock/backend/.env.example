# ─────────────────────────────────────────────────────────────
# Variables para ejecutar el backend fuera de Docker (npm start).
# Copiar a `.env` en esta carpeta y rellenar los valores reales.
# El archivo `.env` está ignorado por git: NUNCA lo subas.
# ─────────────────────────────────────────────────────────────

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_NAME=mydb
DB_PASSWORD=

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Autenticación ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Correo (nodemailer) ---
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=GS Stock <distribuidoragenser@gmail.com>
